# AI model gateway. Default provider is deepseek for backward compatibility.
# Supported providers: deepseek, openai, openai-compatible, ofox
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# Set to disabled if an OpenAI-compatible provider does not support response_format=json_object.
AI_JSON_RESPONSE_FORMAT=enabled

# Optional local proxy for AI calls, for example http://127.0.0.1:7897.
# Leave empty in deployments that can reach the model provider directly.
AI_PROXY_URL=

# Optional per-task model overrides.
AI_LESSON_PLAN_MODEL=
AI_STUDENT_QA_MODEL=
AI_KNOWLEDGE_EXPLAIN_MODEL=
AI_COURSEWARE_MODEL=
AI_COURSEWARE_JSON_MODEL=

# Backward-compatible DeepSeek variables. Used when AI_* is empty.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI variables. Used when AI_PROVIDER=openai and AI_* is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional ofox/OpenAI-compatible variables. Used when AI_PROVIDER=ofox and AI_* is empty.
OFOX_API_KEY=
OFOX_BASE_URL=
OFOX_MODEL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Required for admin-only maintenance scripts and
# migration/table checks. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional real-account browser acceptance config. Do not commit real passwords.
FEEDBACK_LOOP_APP_URL=http://127.0.0.1:3000
FEEDBACK_LOOP_TEACHER_EMAIL=
FEEDBACK_LOOP_TEACHER_PASSWORD=
FEEDBACK_LOOP_STUDENT_EMAIL=
FEEDBACK_LOOP_STUDENT_PASSWORD=
FEEDBACK_LOOP_COURSEWARE_ID=
FEEDBACK_LOOP_KNOWLEDGE_POINT_CODE=
FEEDBACK_LOOP_FEEDBACK_TEXT=这一步没看懂，希望老师再讲一次。
